{
  "name": "autonomous-agent",
  "version": "0.1.0",
  "description": "Autonomous AI Developer System",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "fmt:rust": "cd src-tauri && cargo fmt --check",
    "lint:rust": "cd src-tauri && cargo clippy -- -D warnings",
    "test": "vitest",
    "test:frontend": "vitest run",
    "check": "npm run fmt:rust && npm run lint:rust && npm run typecheck && npm run test:frontend",
    "test:all": "npm run check && npm run test:e2e:smoke",
    "test:e2e": "node --test e2e/webdriver.spec.mjs",
    "test:e2e:smoke": "node --test --test-name-pattern=\"dashboard: shows empty state and can open editor|editor: saves workflow and updates URL with new id\" e2e/webdriver.spec.mjs",
    "coverage:rust:setup": "node ./scripts/ensure-cargo-llvm-cov.mjs --install",
    "coverage:rust:summary": "node ./scripts/ensure-cargo-llvm-cov.mjs && cd src-tauri && cargo llvm-cov --summary-only",
    "coverage:rust": "node ./scripts/ensure-cargo-llvm-cov.mjs && cd src-tauri && cargo llvm-cov --all-features --workspace --lcov --output-path lcov.info",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@tanstack/react-query": "^5.62.7",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@tauri-apps/plugin-sql": "^2.0.1",
    "@tauri-apps/plugin-store": "^2.0.1",
    "@xstate/react": "^6.0.0",
    "@xyflow/react": "^12.3.5",
    "motion": "^12.34.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xstate": "^5.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.49",
    "selenium-webdriver": "^4.40.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
